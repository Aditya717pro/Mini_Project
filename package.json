{
  "name": "meddatahub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unified development workflow for the MedDataHub frontend and API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "node scripts/backend.mjs -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "build": "npm --prefix frontend run build",
    "typecheck": "npm --prefix frontend run typecheck",
    "lint:backend": "node scripts/backend.mjs -m ruff check .",
    "test": "node scripts/backend.mjs -m pytest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
