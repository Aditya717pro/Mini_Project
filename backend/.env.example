# MedDataHub API configuration
APP_NAME=MedDataHub API
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+pymysql://meddatahub:meddatahub@127.0.0.1:3306/meddatahub?charset=utf8mb4
DATABASE_CONNECT_TIMEOUT=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
SQL_ECHO=false

# Password-reset email (SMTP). Leave SMTP_HOST empty to disable email delivery.
# Delivery is fail-closed: if SMTP is unconfigured, the forgot-password endpoint returns 503
# and no reset code is created. If sending fails after code creation, the code is discarded.
# SMTP_USER is accepted as a legacy alias for SMTP_USERNAME.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@meddatahub.local
SMTP_USE_TLS=true
# OTP defaults: 10 minute lifetime, 5 incorrect attempts, 60 second resend cooldown.
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60

# SynthMed generation workers. This uses an in-process worker, not a durable queue.
# A process crash can interrupt active work; startup recovery fails those jobs so they can be resubmitted.
# SYNTHMED_STALE_JOB_AFTER_SECONDS=0 (default) marks every active job found at startup as interrupted.
SYNTHMED_STALE_JOB_RECOVERY_ENABLED=true
SYNTHMED_STALE_JOB_AFTER_SECONDS=0
