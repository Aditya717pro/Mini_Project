# MedDataHub API configuration
APP_NAME=MedDataHub API
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+pymysql://meddatahub:meddatahub@127.0.0.1:3306/meddatahub?charset=utf8mb4
DATABASE_CONNECT_TIMEOUT=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
SQL_ECHO=false

# Password-reset email (SMTP). Leave SMTP_HOST empty to disable email delivery.
# Delivery is fail-closed: if SMTP is unavailable, no reset code is persisted or accepted.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@meddatahub.local
SMTP_USE_TLS=true
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60

# SynthMed generation workers. This P0 uses an in-process worker, not a durable queue.
# Startup recovery fails interrupted active jobs; the age threshold of 0 recovers all active rows.
SYNTHMED_STALE_JOB_RECOVERY_ENABLED=true
SYNTHMED_STALE_JOB_AFTER_SECONDS=0
